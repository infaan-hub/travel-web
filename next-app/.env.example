# ---------------------------------------------------------------------------
# Infaan Tours & Travel — unified Next.js application
# Production environment template. Copy to .env and fill in real values.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# PostgreSQL (Neon)
DATABASE_URL="postgresql://neondb_owner:password@ep-<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct (non-pooled) connection used for migrations
DIRECT_URL="postgresql://neondb_owner:password@ep-<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Public origin of the application (no trailing slash).
APP_URL="https://travelisland.vercel.app"
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_COOKIE_SECURE="true"

# Optional one-time bootstrap token for creating the first administrator.
# Use once, then remove it from the environment.

# Shared rate limiting and caching (Upstash Redis). Optional; an in-process
# fallback is used when these are not set.
RATE_LIMIT_URL=""
RATE_LIMIT_TOKEN=""
CACHE_URL=""
CACHE_TOKEN=""

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@travelisland.app"
PUSH_ENABLED="true"
# The public key must also be exposed to the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
NEXT_PUBLIC_PUSH_ENABLED="true"

# Secret used to protect scheduled job endpoints (/api/cron/*)
CRON_SECRET=""

# Optional external media host. Leave empty to serve uploads from /uploads.
NEXT_PUBLIC_MEDIA_BASE_URL=""

# Non-company production uploads use a connected public Vercel Blob store
# (OIDC recommended). Company logos and covers are stored in PostgreSQL.
# BLOB_READ_WRITE_TOKEN can be used outside Vercel or for local Blob development.

# Feature flags
FEATURE_BOOKING_REFERENCE="true"
FEATURE_GUEST_BOOKING="true"
FEATURE_WORKSPACE_TEMPLATES="true"
FEATURE_MULTI_CURRENCY="true"
FEATURE_AUDIT_LOG="true"
NEXT_PUBLIC_FEATURE_MULTI_CURRENCY="true"
NEXT_PUBLIC_FEATURE_GUEST_BOOKING="true"
NEXT_PUBLIC_DEFAULT_CURRENCY="TZS"

# Logging
LOG_LEVEL="info"

# WhatsApp booking link
WHATSAPP_NUMBER="255711252758"

# Nominatim geocoding
NOMINATIM_USER_AGENT="InfaanTravelApp/1.0 (contact@travelisland.app)"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"

# SMTP / email delivery (Gmail app password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Travel Island <admin@travelisland.app>"
