# ---------------------------------------------------------------------------
# Infaan Tours & Travel — unified Next.js application
# Copy to .env and fill in real values. Never commit real credentials.
# ---------------------------------------------------------------------------

# PostgreSQL (production: managed provider such as Supabase/Neon/RDS)
DATABASE_URL="postgresql://postgres:password@localhost:5432/infaan_travel?schema=public"
# Optional pooled/direct URL when the provider distinguishes them
DIRECT_URL=""

# Public origin of the application (no trailing slash)
APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_COOKIE_SECURE="false"

# Optional one-time bootstrap token for creating the first administrator.
# Use once, then remove it from the environment.
ADMIN_SETUP_TOKEN=""

# Storage: local (development only) or supabase
STORAGE_PROVIDER="local"
STORAGE_URL=""
STORAGE_SERVICE_KEY=""
STORAGE_BUCKET="tours"

# Booking notification email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
BOOKING_NOTIFICATION_EMAIL=""
EMAIL_FROM=""

# WhatsApp booking link
WHATSAPP_NUMBER="255711252758"

# Nominatim geocoding
NOMINATIM_USER_AGENT="InfaanTravelApp/1.0 (contact@example.com)"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"

# Optional: public base URL used for migrated media when not using local storage
# NEXT_PUBLIC_MEDIA_BASE_URL=""
