generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TourCategory {
  zanzibar
  tanzania
  international
}

enum ReviewStatus {
  pending
  approved
  deleted
}

enum BookingStatus {
  pending
  confirmed
  cancelled
}

enum WorkspaceStatus {
  draft
  approved
  completed
}

enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum CompanyBusinessType {
  TOUR_OPERATOR
  SAFARI_OPERATOR
  EXCURSION_PROVIDER
  OTHER
}

enum CompanyRole {
  OWNER
  MANAGER
  STAFF
}

enum CompanyMembershipStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum TourPublicationStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

model User {
  id               Int       @id @default(autoincrement())
  username         String    @unique
  email            String    @default("")
  password         String
  firstName        String    @default("") @map("first_name")
  lastName         String    @default("") @map("last_name")
  isStaff          Boolean   @default(false) @map("is_staff")
  isActive         Boolean   @default(true) @map("is_active")
  isSuperuser      Boolean   @default(false) @map("is_superuser")
  dateJoined       DateTime  @default(now()) @map("date_joined")
  lastLogin        DateTime? @map("last_login")
  sessionVersion   Int       @default(1) @map("session_version")
  emailVerified    Boolean   @default(false) @map("email_verified")
  resetRequestedAt DateTime? @map("reset_requested_at")
  deletedAt        DateTime? @map("deleted_at")

  profile                    Profile?
  bookings                   Booking[]
  reviews                    Review[]
  workspaces                 Workspace[]         @relation("WorkspaceTourist")
  travelTips                 TravelTip[]
  visits                     VisitorTracking[]
  auditLogs                  AuditLog[]
  pushSubscriptions          PushSubscription[]
  notifications              Notification[]
  verificationTokens         VerificationToken[]
  companiesCreated           Company[]           @relation("CompanyCreatedBy")
  companyMemberships         CompanyMembership[] @relation("CompanyMembershipUser")
  companyMembershipsAssigned CompanyMembership[] @relation("CompanyMembershipAssignedBy")
  toursPublished             Tour[]              @relation("TourPublishedBy")

  @@index([email])
  @@index([isStaff])
  @@index([deletedAt])
  @@map("users")
}

model Profile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  fullName  String   @default("") @map("full_name")
  phone     String   @default("")
  address   String   @default("")
  image     String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Company {
  id                    Int                      @id @default(autoincrement())
  name                  String
  slug                  String                   @unique
  description           String                   @default("")
  registrationReference String?                  @map("registration_reference")
  businessType          CompanyBusinessType      @default(TOUR_OPERATOR) @map("business_type")
  logoImageKey          String?                  @map("logo_image_key")
  coverImageKey         String?                  @map("cover_image_key")
  contactEmail          String                   @default("") @map("contact_email")
  contactPhone          String                   @default("") @map("contact_phone")
  alternativePhone      String?                  @map("alternative_phone")
  whatsappNumber        String?                  @map("whatsapp_number")
  address               String                   @default("")
  locality              String?
  district              String?
  region                String?
  country               String                   @default("Tanzania")
  latitude              Float?
  longitude             Float?
  website               String?
  socialLinks           Json?                    @map("social_links")
  openingHours          String?                  @map("opening_hours")
  status                CompanyStatus            @default(PENDING)
  isPublic              Boolean                  @default(false) @map("is_public")
  createdByUserId       Int?                     @map("created_by_user_id")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  suspendedAt           DateTime?                @map("suspended_at")
  archivedAt            DateTime?                @map("archived_at")
  searchVector          Unsupported("tsvector")? @map("search_vector")

  createdBy     User?               @relation("CompanyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  memberships   CompanyMembership[]
  tours         Tour[]
  bookings      Booking[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([status, isPublic])
  @@index([businessType])
  @@index([region])
  @@index([locality])
  @@index([createdAt])
  @@index([searchVector], type: Gin)
  @@map("companies")
}

model CompanyMembership {
  id               Int                     @id @default(autoincrement())
  companyId        Int                     @map("company_id")
  userId           Int                     @map("user_id")
  role             CompanyRole
  status           CompanyMembershipStatus @default(INVITED)
  assignedByUserId Int?                    @map("assigned_by_user_id")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  revokedAt        DateTime?               @map("revoked_at")

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User    @relation("CompanyMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?   @relation("CompanyMembershipAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([companyId, role, status])
  @@map("company_memberships")
}

model Tour {
  id                Int                      @id @default(autoincrement())
  title             String
  description       String
  shortDescription  String                   @default("") @map("short_description")
  price             Decimal                  @db.Decimal(10, 2)
  duration          String
  destination       String
  destinationLat    Float?                   @map("destination_lat")
  destinationLng    Float?                   @map("destination_lng")
  category          TourCategory             @default(international)
  image             String?
  image2            String?
  image3            String?
  includes          Json                     @default("[]")
  excludes          Json                     @default("[]")
  available         Boolean                  @default(true)
  featured          Boolean                  @default(false)
  maxTravelers      Int                      @default(10) @map("max_travelers")
  companyId         Int?                     @map("company_id")
  publicationStatus TourPublicationStatus    @default(DRAFT) @map("publication_status")
  publishedAt       DateTime?                @map("published_at")
  publishedByUserId Int?                     @map("published_by_user_id")
  moderationNote    String?                  @map("moderation_note")
  deletedAt         DateTime?                @map("deleted_at")
  searchVector      Unsupported("tsvector")? @map("search_vector")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  company       Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  publishedBy   User?              @relation("TourPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  galleryImages TourGalleryImage[]
  itinerary     ItineraryItem[]
  reviews       Review[]
  bookings      Booking[]
  workspaces    Workspace[]        @relation("WorkspaceTours")
  translations  TourTranslation[]

  @@index([companyId, publicationStatus, deletedAt])
  @@index([companyId, createdAt])
  @@index([publicationStatus, deletedAt])
  @@index([category, available])
  @@index([featured])
  @@index([price])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([destination])
  @@index([searchVector], type: Gin)
  @@map("tours")
}

model TourGalleryImage {
  id        Int      @id @default(autoincrement())
  tourId    Int      @map("tour_id")
  image     String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId, order])
  @@map("tour_gallery_images")
}

model ItineraryItem {
  id          Int    @id @default(autoincrement())
  tourId      Int    @map("tour_id")
  day         Int
  title       String
  description String

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId, day])
  @@map("itinerary_items")
}

model Attraction {
  id              Int                      @id @default(autoincrement())
  name            String
  description     String                   @default("")
  location        String
  region          String                   @default("")
  category        String                   @default("")
  image           String?
  bestTimeToVisit String                   @default("") @map("best_time_to_visit")
  entryFee        String                   @default("") @map("entry_fee")
  activities      String                   @default("")
  deletedAt       DateTime?                @map("deleted_at")
  searchVector    Unsupported("tsvector")? @map("search_vector")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@index([region])
  @@index([category])
  @@index([deletedAt])
  @@index([searchVector], type: Gin)
  @@map("attractions")
}

model Review {
  id        Int          @id @default(autoincrement())
  userId    Int?         @map("user_id")
  tourId    Int?         @map("tour_id")
  rating    Int
  content   String
  status    ReviewStatus @default(pending)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour Tour? @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([userId, tourId])
  @@index([tourId, status])
  @@index([status, createdAt])
  @@map("reviews")
}

model Booking {
  id                  Int           @id @default(autoincrement())
  reference           String?       @unique
  userId              Int?          @map("user_id")
  tourId              Int           @map("tour_id")
  companyId           Int?          @map("company_id")
  companyNameSnapshot String?       @map("company_name_snapshot")
  tourTitleSnapshot   String?       @map("tour_title_snapshot")
  fullName            String        @map("full_name")
  email               String
  phone               String
  address             String        @default("")
  travelers           Int
  travelDate          DateTime      @map("travel_date") @db.Date
  notes               String        @default("")
  status              BookingStatus @default(pending)
  userLat             Float?        @map("user_lat")
  userLng             Float?        @map("user_lng")
  distanceKm          Float?        @map("distance_km")
  estimatedTimeMins   Int?          @map("estimated_time_mins")
  googleMapsUrl       String        @default("") @map("google_maps_url")
  createdAt           DateTime      @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tour    Tour     @relation(fields: [tourId], references: [id], onDelete: Restrict)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([tourId])
  @@index([tourId, travelDate])
  @@index([companyId, status, travelDate])
  @@index([companyId, createdAt])
  @@map("bookings")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String   @default("")
  subject   String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([isRead, createdAt])
  @@map("contact_messages")
}

model TravelTip {
  id           Int                      @id @default(autoincrement())
  title        String
  content      String
  category     String                   @default("")
  image        String?
  authorId     Int?                     @map("author_id")
  published    Boolean                  @default(true)
  deletedAt    DateTime?                @map("deleted_at")
  searchVector Unsupported("tsvector")? @map("search_vector")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([published, createdAt])
  @@index([category])
  @@index([deletedAt])
  @@index([searchVector], type: Gin)
  @@map("travel_tips")
}

model HomeSetting {
  id            Int      @id @default(1)
  heroImage     String?  @map("hero_image")
  zanzibarImage String?  @map("zanzibar_image")
  tanzaniaImage String?  @map("tanzania_image")
  moreExperiencesImage String? @map("more_experiences_image")
  moreExperiencesImage1 String? @map("more_experiences_image_1")
  moreExperiencesImage2 String? @map("more_experiences_image_2")
  moreExperiencesImage3 String? @map("more_experiences_image_3")
  moreExperiencesImage4 String? @map("more_experiences_image_4")
  moreExperiencesImage5 String? @map("more_experiences_image_5")
  moreExperiencesImage6 String? @map("more_experiences_image_6")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("home_settings")
}

model TravelDriver {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  image     String?
  createdAt DateTime @default(now()) @map("created_at")

  workspaces Workspace[] @relation("WorkspaceDriver")

  @@map("travel_drivers")
}

model TravelVehicle {
  id          Int      @id @default(autoincrement())
  carName     String   @map("car_name")
  plateNumber String   @map("plate_number")
  createdAt   DateTime @default(now()) @map("created_at")

  workspaces Workspace[] @relation("WorkspaceVehicle")

  @@map("travel_vehicles")
}

model Hotel {
  id        Int      @id @default(autoincrement())
  name      String
  location  String
  phone     String   @default("")
  image     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rooms      Room[]
  workspaces Workspace[] @relation("WorkspaceHotel")

  @@index([name])
  @@map("hotels")
}

model Room {
  id          Int      @id @default(autoincrement())
  hotelId     Int      @map("hotel_id")
  name        String
  price       Decimal  @db.Decimal(10, 2)
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  hotel      Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  workspaces Workspace[] @relation("WorkspaceRooms")

  @@index([hotelId])
  @@map("rooms")
}

model Workspace {
  id                      Int             @id @default(autoincrement())
  touristId               Int?            @map("tourist_id")
  touristName             String          @default("") @map("tourist_name")
  touristEmail            String          @default("") @map("tourist_email")
  selectedHotelId         Int?            @map("selected_hotel_id")
  selectedTravelDriverId  Int?            @map("selected_travel_driver_id")
  selectedTravelVehicleId Int?            @map("selected_travel_vehicle_id")
  totalPrice              Decimal?        @map("total_price") @db.Decimal(12, 2)
  notes                   String          @default("")
  status                  WorkspaceStatus @default(draft)
  messageSent             Boolean         @default(false) @map("message_sent")
  isTemplate              Boolean         @default(false) @map("is_template")
  pricingDraft            Json?           @map("pricing_draft")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  tourist               User?           @relation("WorkspaceTourist", fields: [touristId], references: [id], onDelete: SetNull)
  selectedHotel         Hotel?          @relation("WorkspaceHotel", fields: [selectedHotelId], references: [id], onDelete: SetNull)
  selectedTravelDriver  TravelDriver?   @relation("WorkspaceDriver", fields: [selectedTravelDriverId], references: [id], onDelete: SetNull)
  selectedTravelVehicle TravelVehicle?  @relation("WorkspaceVehicle", fields: [selectedTravelVehicleId], references: [id], onDelete: SetNull)
  selectedTours         Tour[]          @relation("WorkspaceTours")
  selectedRooms         Room[]          @relation("WorkspaceRooms")
  tasks                 WorkspaceTask[]

  @@index([status, createdAt])
  @@index([touristId])
  @@map("workspaces")
}

model WorkspaceTask {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  day         Int
  title       String
  description String   @default("")
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, day])
  @@map("workspace_tasks")
}

model VisitorTracking {
  id              Int      @id @default(autoincrement())
  sessionId       String   @map("session_id")
  pageUrl         String   @map("page_url")
  userId          Int?     @map("user_id")
  ipAddress       String?  @map("ip_address")
  userAgent       String   @default("") @map("user_agent")
  isAuthenticated Boolean  @default(false) @map("is_authenticated")
  tourId          Int?     @map("tour_id")
  createdAt       DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([createdAt])
  @@index([tourId])
  @@map("visitor_tracking")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?     @map("actor_id")
  companyId Int?     @map("company_id")
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(80)
  entityId  String?  @map("entity_id") @db.VarChar(64)
  before    Json?
  after     Json?
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity, entityId])
  @@index([companyId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  endpoint  String   @unique @db.Text
  p256dh    String   @map("p256dh") @db.VarChar(255)
  auth      String   @db.VarChar(255)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  companyId Int?     @map("company_id")
  title     String   @db.VarChar(160)
  body      String   @db.Text
  url       String?  @db.VarChar(500)
  tag       String?  @db.VarChar(80)
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([companyId, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

model VerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  purpose   String    @db.VarChar(32)
  codeHash  String    @map("code_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model TourTranslation {
  id               Int    @id @default(autoincrement())
  tourId           Int    @map("tour_id")
  locale           String @db.VarChar(8)
  title            String
  description      String @default("")
  shortDescription String @default("") @map("short_description")

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, locale])
  @@map("tour_translations")
}

model FunnelEvent {
  id        Int      @id @default(autoincrement())
  sessionId String   @map("session_id") @db.VarChar(100)
  stage     String   @db.VarChar(32)
  tourId    Int?     @map("tour_id")
  bookingId Int?     @map("booking_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([stage, createdAt])
  @@index([sessionId])
  @@map("funnel_events")
}
