{
  "$comment": "Design review policy for the Travel. app. Consumed by next-app/scripts/design-gate.mjs and documented in .github/skills/travel-ui-design/. Paths are relative to next-app/ unless noted.",
  "version": 1,
  "appRoot": "next-app",
  "defaultMode": "report",
  "strictMode": "fail",
  "ignore": [
    ".github/**",
    ".opencode/**",
    ".claude/**",
    ".agents/**",
    ".vscode/**",
    ".idea/**",
    "opencode.json",
    ".gitignore",
    ".gitattributes",
    ".editorconfig",
    ".prettierrc*",
    "src/app/api/**",
    "src/app/actions/**",
    "src/lib/**",
    "src/context/**",
    "src/hooks/**",
    "src/types/**",
    "src/generated/**",
    "tests/**",
    "scripts/**",
    "prisma/**",
    "docs/**",
    "infra/**",
    "files/**",
    ".data/**",
    ".next/**",
    "node_modules/**",
    "public/uploads/**",
    "public/data/**",
    "public/sw.js",
    "**/*.test.ts",
    "**/*.spec.ts",
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "next-env.d.ts",
    "vitest.config.mts",
    "eslint.config.mjs",
    "next.config.*",
    "postcss.config.*",
    "components.json",
    "AGENTS.md",
    "DEVELOPMENT.md",
    "README.md",
    ".env*"
  ],
  "tiers": {
    "SYSTEM": {
      "label": "Shared shell and design system",
      "rank": 0,
      "strict": true,
      "surfaces": [
        "globals.css / travel-theme.css tokens",
        "AppFrame, TopHeader, Sidebar",
        "PageHero, PWA surfaces, ui primitives",
        "error, loading, and not-found states"
      ],
      "critique": "Every change. Check P0 first, then confirm P3/P4 tables and dashboards still work.",
      "handoff": "Any token, layout primitive, or shell change.",
      "audits": ["audit:theme", "audit:spacing", "audit:contrast", "audit:layout"],
      "routePatterns": [],
      "fileGlobs": [
        "src/app/globals.css",
        "src/app/travel-theme.css",
        "src/app/layout.tsx",
        "src/app/error.tsx",
        "src/app/global-error.tsx",
        "src/app/loading.tsx",
        "src/app/not-found.tsx",
        "src/app/(public)/loading.tsx",
        "src/components/AppFrame.tsx",
        "src/components/TopHeader.tsx",
        "src/components/Sidebar.tsx",
        "src/components/sidebar.module.css",
        "src/components/PageHero.tsx",
        "src/components/PageHero.module.css",
        "src/components/Skeleton.tsx",
        "src/components/ToastProvider.tsx",
        "src/components/ModalA11y.tsx",
        "src/components/icons.tsx",
        "src/components/Pwa*.tsx",
        "src/components/PushPrompt.tsx",
        "src/components/ServiceWorkerRegister.tsx",
        "src/components/ui/**",
        "public/manifest.json",
        "public/apple-touch-icon.png",
        "public/favicon.ico",
        "public/favicon.svg",
        "public/icons.svg",
        "public/travel.logo.jpeg",
        "public/icons/**"
      ]
    },
    "P0": {
      "label": "Discovery and conversion",
      "rank": 1,
      "strict": true,
      "surfaces": ["Home /", "Experiences /tours and /tours/[category]", "Tour detail /tour/[id]", "Booking /booking and /booking/[tourId]"],
      "critique": "Every change before merge.",
      "handoff": "Any change another developer implements, or any new state or flow.",
      "audits": ["audit:contrast", "audit:layout", "smoke:browser"],
      "routePatterns": ["/", "/tours", "/tours/:category", "/tour/:id", "/booking", "/booking/:tourId"],
      "fileGlobs": [
        "src/app/(public)/page.tsx",
        "src/app/(public)/tours/**",
        "src/app/(public)/tour/**",
        "src/app/(public)/booking/**",
        "src/features/pages/HomePage.tsx",
        "src/features/pages/home-page.module.css",
        "src/features/pages/ToursPage.tsx",
        "src/features/pages/tours-page.module.css",
        "src/features/pages/TourDetailPage.tsx",
        "src/features/pages/tour-detail-page.module.css",
        "src/features/pages/BookingPage.tsx",
        "src/features/pages/booking-page.module.css",
        "src/components/TourCard.tsx",
        "src/components/BentoHero.tsx",
        "src/components/BentoHero.module.css",
        "src/components/ExperienceCard.tsx",
        "src/components/DestinationCard.tsx",
        "src/components/DestinationCard.css",
        "src/components/AttractionCard.tsx",
        "src/components/MoreExperiencesEmptyState.tsx",
        "src/components/MoreExperiencesEmptyState.module.css",
        "src/components/ZanzibarAttractions.tsx",
        "src/components/zanzibar-attractions.module.css",
        "src/components/CountUp.tsx"
      ]
    },
    "P1": {
      "label": "Trust, access, and first run",
      "rank": 2,
      "strict": false,
      "surfaces": ["Companies /companies and /company/[slug]", "Trips /trips and /trips/[id]", "Auth routes", "Contact /contact", "Onboarding and tour-company application"],
      "critique": "Before launch and after any flow change.",
      "handoff": "New form, new state, or cross-team implementation.",
      "audits": ["audit:contrast", "audit:layout", "smoke:browser"],
      "routePatterns": [
        "/companies",
        "/company/:slug",
        "/trips",
        "/trips/:id",
        "/login",
        "/register",
        "/forgot-password",
        "/reset-password",
        "/verify-email",
        "/contact",
        "/onboarding",
        "/tour-company/dashboard"
      ],
      "fileGlobs": [
        "src/app/companies/**",
        "src/app/company/[slug]/**",
        "src/app/(public)/trips/**",
        "src/app/(public)/login/**",
        "src/app/(public)/register/**",
        "src/app/(public)/forgot-password/**",
        "src/app/(public)/reset-password/**",
        "src/app/(public)/verify-email/**",
        "src/app/(public)/contact/**",
        "src/app/onboarding/**",
        "src/app/tour-company/**",
        "src/features/pages/CompaniesPage.tsx",
        "src/features/pages/company-public.module.css",
        "src/features/pages/company-profile-page.module.css",
        "src/features/pages/TripsPage.tsx",
        "src/features/pages/TripDetailPage.tsx",
        "src/features/pages/trips-page.module.css",
        "src/features/pages/LoginPage.tsx",
        "src/features/pages/RegisterPage.tsx",
        "src/features/pages/ForgotPasswordPage.tsx",
        "src/features/pages/ResetPasswordPage.tsx",
        "src/features/pages/VerifyEmailPage.tsx",
        "src/features/pages/auth-page.module.css",
        "src/features/pages/ContactPage.tsx",
        "src/features/pages/contact-page.module.css",
        "src/features/pages/OnboardingPage.tsx",
        "src/features/pages/TourCompanyApplicationPage.tsx",
        "src/features/pages/CompanyForm.tsx",
        "src/components/TripPlaceMapPicker.tsx",
        "src/components/trip-place-picker.module.css",
        "src/components/TripRouteOverlayMap.tsx",
        "src/components/LocationPicker.tsx"
      ]
    },
    "P2": {
      "label": "Customer account",
      "rank": 3,
      "strict": false,
      "surfaces": ["Bookings /bookings", "Profile /profile", "Settings /settings"],
      "critique": "On new flows and after support-reported confusion.",
      "handoff": "New field, status, or destructive action.",
      "audits": ["audit:contrast"],
      "routePatterns": ["/bookings", "/profile", "/settings"],
      "fileGlobs": [
        "src/app/(customer)/bookings/**",
        "src/app/(customer)/profile/**",
        "src/app/(customer)/settings/**",
        "src/features/pages/BookingsPage.tsx",
        "src/features/pages/ProfilePage.tsx",
        "src/features/pages/account-settings.module.css"
      ]
    },
    "P3": {
      "label": "Company workspace",
      "rank": 4,
      "strict": false,
      "surfaces": ["Company select /company/select", "Dashboard, tours, trips, bookings, analytics, profile", "Staff view-workspace /view-workspace"],
      "critique": "On new dashboards, tables, or navigation changes.",
      "handoff": "Any table, filter, chart, or permission-dependent action.",
      "audits": ["audit:layout", "audit:contrast"],
      "routePatterns": [
        "/company",
        "/company/select",
        "/company/dashboard",
        "/company/tours",
        "/company/tours/create",
        "/company/tours/:id",
        "/company/trips",
        "/company/bookings",
        "/company/bookings/:id",
        "/company/analytics",
        "/company/profile",
        "/view-workspace",
        "/view-workspace/:id"
      ],
      "fileGlobs": [
        "src/app/company/page.tsx",
        "src/app/company/select/**",
        "src/app/company/(protected)/**",
        "src/app/(staff)/view-workspace/**",
        "src/features/pages/CompanySelectPage.tsx",
        "src/features/pages/CompanyWorkspacePage.tsx",
        "src/features/pages/CompanyToursPage.tsx",
        "src/features/pages/CompanyTourFormPage.tsx",
        "src/features/pages/CompanyTripsPage.tsx",
        "src/features/pages/CompanyBookingsPage.tsx",
        "src/features/pages/CompanyBookingDetailPage.tsx",
        "src/features/pages/CompanyAnalyticsPage.tsx",
        "src/features/pages/CompanyAnalyticsClient.tsx",
        "src/features/pages/CompanyAnalyticsCharts.tsx",
        "src/features/pages/CompanyDashboardCharts.tsx",
        "src/features/pages/CompanyDashboardChartsClient.tsx",
        "src/features/pages/CompanyProfilePage.tsx",
        "src/features/pages/ViewWorkspaceListPage.tsx",
        "src/features/pages/ViewWorkspacePage.tsx",
        "src/features/pages/company-analytics.module.css",
        "src/features/pages/company-bookings.module.css",
        "src/features/pages/company-dashboard.module.css",
        "src/features/pages/company-operations.module.css",
        "src/features/pages/company-profile.module.css",
        "src/features/pages/company-tours.module.css",
        "src/features/pages/company-trips.module.css",
        "src/features/pages/company-workspace.module.css",
        "src/components/CompanySwitcher.tsx",
        "src/components/CompanyWorkspaceHeader.tsx",
        "src/components/OpeningHoursEditor.tsx",
        "src/components/OpeningHoursEditor.module.css"
      ]
    },
    "P4": {
      "label": "Admin",
      "rank": 5,
      "strict": false,
      "surfaces": ["Admin dashboards", "Company and tour editors", "Bookings, customers, reviews, messages", "Home editor, pricing, tour plan, work-space"],
      "critique": "On new editors and data-dense screens.",
      "handoff": "Any editor, bulk action, or publish flow.",
      "audits": ["audit:theme", "audit:layout"],
      "routePatterns": ["/admin", "/admin/**"],
      "fileGlobs": [
        "src/app/admin/**",
        "src/features/pages/Admin*.tsx",
        "src/features/pages/admin-*.module.css",
        "src/features/pages/AnalyticsCharts.tsx",
        "src/features/pages/CompanyForm.tsx"
      ]
    }
  }
}
